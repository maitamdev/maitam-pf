# Add this value locally and in Vercel Project Settings > Environment Variables.
# Never expose it through a NEXT_PUBLIC_ variable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional read-only token for higher GitHub API limits.
GITHUB_TOKEN=

# Canonical production URL used by sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=https://maitam-pf.vercel.app
